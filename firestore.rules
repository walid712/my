rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitive Helpers ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidLanguage(lang) {
      return lang is string && lang in ['ar', 'en', 'fr', 'es'];
    }

    function isValidTradeCategory(cat) {
      return cat is string && cat in [
        'plumbing', 'electrical', 'carpentry', 'cleaning', 'hvac', 'appliance',
        'painting', 'zellige', 'metalwork', 'gardening', 'moving', 'smart_home'
      ];
    }

    function isValidContinent(cont) {
      return cont is string && cont in [
        'africa', 'europe', 'asia', 'north_america', 'south_america', 'oceania'
      ];
    }

    // --- Validation Blueprints ---
    function isValidUserSummary(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
             isValidLanguage(data.preferredLanguage) &&
             (!('preferredCity' in data) || (data.preferredCity is string && data.preferredCity.size() <= 80)) &&
             (!('preferredCountry' in data) || (data.preferredCountry is string && data.preferredCountry.size() <= 80)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidUserPrivateInfo(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 120)) &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 40)) &&
             (!('homeAddress' in data) || (data.homeAddress is string && data.homeAddress.size() <= 200)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidFavoriteProvider(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             isValidId(data.providerId) &&
             data.providerName is string && data.providerName.size() >= 2 && data.providerName.size() <= 80 &&
             isValidTradeCategory(data.tradeCategory) &&
             data.city is string && data.city.size() >= 2 && data.city.size() <= 80 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidServiceProvider(data) {
      return data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&
             data.businessName is string && data.businessName.size() >= 2 && data.businessName.size() <= 80 &&
             isValidTradeCategory(data.tradeCategory) &&
             data.serviceKind is string && data.serviceKind in ['artisan', 'home_service'] &&
             data.bio is string && data.bio.size() >= 5 && data.bio.size() <= 500 &&
             data.city is string && data.city.size() >= 2 && data.city.size() <= 80 &&
             data.country is string && data.country.size() >= 2 && data.country.size() <= 80 &&
             isValidContinent(data.continent) &&
             data.latitude is number && data.latitude >= -90.0 && data.latitude <= 90.0 &&
             data.longitude is number && data.longitude >= -180.0 && data.longitude <= 180.0 &&
             data.hourlyRate is number && data.hourlyRate >= 1.0 && data.hourlyRate <= 10000.0 &&
             data.currency is string && data.currency.size() >= 3 && data.currency.size() <= 5 &&
             data.languages is list && data.languages.size() >= 1 && data.languages.size() <= 4 &&
             (data.languages.size() == 0 || data.languages[0] is string) &&
             data.rating is number && data.rating >= 0.0 && data.rating <= 5.0 &&
             data.reviewCount is int && data.reviewCount >= 0 && data.reviewCount <= 100000 &&
             data.yearsExperience is int && data.yearsExperience >= 0 && data.yearsExperience <= 80 &&
             data.verificationTier is string && data.verificationTier in ['unverified', 'id_verified', 'master_artisan', 'insured_pro'] &&
             data.availableToday is bool &&
             data.published is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidProviderReview(data) {
      return isValidId(data.providerId) &&
             isValidId(data.bookingId) &&
             data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 &&
             data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80 &&
             data.rating is int && data.rating >= 1 && data.rating <= 5 &&
             data.comment is string && data.comment.size() >= 2 && data.comment.size() <= 400 &&
             isValidLanguage(data.language) &&
             data.published is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidServiceBooking(data) {
      return data.clientId is string && data.clientId.size() >= 1 && data.clientId.size() <= 128 &&
             data.clientName is string && data.clientName.size() >= 1 && data.clientName.size() <= 80 &&
             (!('clientPhone' in data) || (data.clientPhone is string && data.clientPhone.size() <= 40)) &&
             (!('serviceAddress' in data) || (data.serviceAddress is string && data.serviceAddress.size() <= 200)) &&
             isValidId(data.providerId) &&
             data.providerName is string && data.providerName.size() >= 2 && data.providerName.size() <= 80 &&
             data.providerOwnerId is string && data.providerOwnerId.size() >= 1 && data.providerOwnerId.size() <= 128 &&
             isValidTradeCategory(data.tradeCategory) &&
             data.serviceTitle is string && data.serviceTitle.size() >= 2 && data.serviceTitle.size() <= 120 &&
             data.scheduledDate is string && data.scheduledDate.size() >= 4 && data.scheduledDate.size() <= 40 &&
             (!('scheduledAt' in data) || (data.scheduledAt is timestamp && data.scheduledDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}$'))) &&
             data.city is string && data.city.size() >= 2 && data.city.size() <= 80 &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 400)) &&
             data.estimatedPrice is number && data.estimatedPrice >= 0.0 && data.estimatedPrice <= 100000.0 &&
             data.currency is string && data.currency.size() >= 3 && data.currency.size() <= 5 &&
             data.status is string && data.status in ['pending', 'confirmed', 'completion_pending', 'completed', 'cancelled'] &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // --- Collection Rules ---

    // 1. User Summary & Preferences
    match /users/{userId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'displayName', 'preferredLanguage', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'preferredLanguage', 'preferredCity', 'preferredCountry', 'createdAt', 'updatedAt']) &&
                       isValidUserSummary(incoming());
      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserSummary(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'preferredLanguage', 'preferredCity', 'preferredCountry', 'updatedAt']);
      allow delete: if isOwner(userId) && isValidId(userId);

      // 2. User Private PII Split Collection
      match /private/{docId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(docId) &&
                         incoming().userId == request.auth.uid &&
                         incoming().keys().hasAll(['userId', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'email', 'phone', 'homeAddress', 'createdAt', 'updatedAt']) &&
                         isValidUserPrivateInfo(incoming());
        allow update: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(docId) &&
                         isValidUserPrivateInfo(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['email', 'phone', 'homeAddress', 'updatedAt']);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(docId);
      }

      // 3. User Bookmarked Providers
      match /favorites/{providerId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(providerId) &&
                         incoming().userId == request.auth.uid &&
                         incoming().providerId == providerId &&
                         incoming().keys().hasAll(['userId', 'providerId', 'providerName', 'tradeCategory', 'city', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'providerId', 'providerName', 'tradeCategory', 'city', 'createdAt']) &&
                         isValidFavoriteProvider(incoming());
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(providerId);
      }
    }

    // 4. Global Marketplace Providers
    match /providers/{providerId} {
      allow get, list: if isSignedIn() && existing().published == true;

      allow create: if isSignedIn() &&
                       isValidId(providerId) &&
                       providerId == request.auth.uid &&
                       incoming().ownerId == request.auth.uid &&
                       incoming().published == true &&
                       incoming().rating == 0 &&
                       incoming().reviewCount == 0 &&
                       incoming().verificationTier == 'unverified' &&
                       incoming().keys().hasAll([
                         'ownerId', 'businessName', 'tradeCategory', 'serviceKind', 'bio',
                         'city', 'country', 'continent', 'latitude', 'longitude',
                         'hourlyRate', 'currency', 'languages', 'rating', 'reviewCount',
                         'yearsExperience', 'verificationTier', 'availableToday', 'published',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'ownerId', 'businessName', 'tradeCategory', 'serviceKind', 'bio',
                         'city', 'country', 'continent', 'latitude', 'longitude',
                         'hourlyRate', 'currency', 'languages', 'rating', 'reviewCount',
                         'yearsExperience', 'verificationTier', 'availableToday', 'published',
                         'createdAt', 'updatedAt'
                       ]) &&
                       isValidServiceProvider(incoming());

      allow update: if isSignedIn() &&
                       isValidId(providerId) &&
                       isValidServiceProvider(incoming()) &&
                       existing().ownerId == request.auth.uid &&
                       incoming().ownerId == existing().ownerId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'businessName', 'tradeCategory', 'serviceKind', 'bio',
                         'city', 'country', 'continent', 'latitude', 'longitude',
                         'hourlyRate', 'currency', 'languages', 'yearsExperience',
                         'availableToday', 'published', 'updatedAt'
                       ]) ||
                       (isSignedIn() &&
                        request.auth.token.admin == true &&
                        incoming().ownerId == existing().ownerId &&
                        incoming().createdAt == existing().createdAt &&
                        incoming().verificationTier in ['unverified', 'id_verified', 'master_artisan', 'insured_pro'] &&
                        incoming().diff(existing()).affectedKeys().hasOnly(['verificationTier', 'updatedAt']));

      allow delete: if isSignedIn() && isValidId(providerId) && existing().ownerId == request.auth.uid;

      // 5. Provider Reviews Subcollection
      match /reviews/{reviewId} {
        allow get, list: if isSignedIn() && existing().published == true;

        allow create: if isSignedIn() &&
                         isValidId(providerId) &&
                         isValidId(reviewId) &&
                         incoming().authorId == request.auth.uid &&
                         reviewId == request.auth.uid &&
                         incoming().providerId == providerId &&
                         get(/databases/$(database)/documents/providers/$(providerId)).data.ownerId != request.auth.uid &&
                         exists(/databases/$(database)/documents/bookings/$(incoming().bookingId)) &&
                         get(/databases/$(database)/documents/bookings/$(incoming().bookingId)).data.clientId == request.auth.uid &&
                         get(/databases/$(database)/documents/bookings/$(incoming().bookingId)).data.providerId == providerId &&
                         get(/databases/$(database)/documents/bookings/$(incoming().bookingId)).data.status == 'completed' &&
                         incoming().published == true &&
                         incoming().keys().hasAll(['providerId', 'bookingId', 'authorId', 'authorName', 'rating', 'comment', 'language', 'published', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['providerId', 'bookingId', 'authorId', 'authorName', 'rating', 'comment', 'language', 'published', 'createdAt', 'updatedAt']) &&
                         isValidProviderReview(incoming()) &&
                         exists(/databases/$(database)/documents/providers/$(providerId));

        allow update: if isSignedIn() &&
                         isValidId(providerId) &&
                         isValidId(reviewId) &&
                         isValidProviderReview(incoming()) &&
                         existing().authorId == request.auth.uid &&
                         reviewId == request.auth.uid &&
                         incoming().authorId == existing().authorId &&
                         incoming().providerId == existing().providerId &&
                         incoming().bookingId == existing().bookingId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['rating', 'comment', 'language', 'updatedAt']);

        allow delete: if isSignedIn() && isValidId(providerId) && isValidId(reviewId) && existing().authorId == request.auth.uid;
      }
    }

    // 6. Service Bookings
    match /bookings/{bookingId} {
      allow get, list: if isSignedIn() && (
        existing().clientId == request.auth.uid ||
        existing().providerOwnerId == request.auth.uid
      );

      allow create: if isSignedIn() &&
                       isValidId(bookingId) &&
                       incoming().clientId == request.auth.uid &&
                       incoming().status == 'pending' &&
                       incoming().scheduledAt > request.time &&
                       incoming().keys().hasAll([
                         'clientId', 'clientName', 'providerId', 'providerName', 'providerOwnerId',
                         'tradeCategory', 'serviceTitle', 'scheduledDate', 'scheduledAt', 'city',
                         'estimatedPrice', 'currency', 'status', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'clientId', 'clientName', 'providerId', 'providerName', 'providerOwnerId',
                         'tradeCategory', 'serviceTitle', 'scheduledDate', 'scheduledAt', 'city', 'notes', 'clientPhone', 'serviceAddress',
                         'estimatedPrice', 'currency', 'status', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidServiceBooking(incoming()) &&
                       exists(/databases/$(database)/documents/providers/$(incoming().providerId)) &&
                       get(/databases/$(database)/documents/providers/$(incoming().providerId)).data.ownerId == incoming().providerOwnerId;

      allow update: if isSignedIn() &&
                       isValidId(bookingId) &&
                       isValidServiceBooking(incoming()) &&
                       existing().status != 'completed' &&
                       existing().status != 'cancelled' &&
                       incoming().clientId == existing().clientId &&
                       incoming().providerId == existing().providerId &&
                       incoming().providerOwnerId == existing().providerOwnerId &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         (existing().clientId == request.auth.uid &&
                          (
                            (existing().status == 'pending' &&
                             incoming().status in ['pending', 'cancelled'] &&
                             (incoming().status == 'cancelled' || !('scheduledAt' in incoming()) || incoming().scheduledAt > request.time) &&
                             incoming().diff(existing()).affectedKeys().hasOnly(['scheduledDate', 'scheduledAt', 'notes', 'status', 'updatedAt'])) ||
                            (existing().status == 'completion_pending' &&
                             incoming().status == 'completed' &&
                             incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']))
                          )) ||
                         (existing().providerOwnerId == request.auth.uid &&
                          (
                            (existing().status == 'pending' && incoming().status in ['confirmed', 'cancelled']) ||
                            (existing().status == 'confirmed' && incoming().status in ['completion_pending', 'cancelled'])
                          ) &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']))
                       );

      allow delete: if isSignedIn() &&
                       isValidId(bookingId) &&
                       existing().clientId == request.auth.uid &&
                       existing().status == 'pending';
    }
  }
}
