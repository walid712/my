#!/usr/bin/env sh
# Lightweight Gradle bootstrap for environments where the wrapper JAR is not bundled.
set -eu
APP_HOME=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
GRADLE_VERSION="9.3.1"
GRADLE_USER_HOME="${GRADLE_USER_HOME:-$HOME/.gradle}"
DIST_DIR="$GRADLE_USER_HOME/trustcraft-wrapper/gradle-$GRADLE_VERSION"
GRADLE_BIN="$DIST_DIR/bin/gradle"
if [ ! -x "$GRADLE_BIN" ]; then
  mkdir -p "$GRADLE_USER_HOME/trustcraft-wrapper"
  ARCHIVE="$GRADLE_USER_HOME/trustcraft-wrapper/gradle-$GRADLE_VERSION-bin.zip"
  if [ ! -f "$ARCHIVE" ]; then
    if command -v curl >/dev/null 2>&1; then
      curl -fL "https://services.gradle.org/distributions/gradle-$GRADLE_VERSION-bin.zip" -o "$ARCHIVE"
    elif command -v wget >/dev/null 2>&1; then
      wget -O "$ARCHIVE" "https://services.gradle.org/distributions/gradle-$GRADLE_VERSION-bin.zip"
    else
      echo "Install curl or wget to download Gradle $GRADLE_VERSION." >&2; exit 1
    fi
  fi
  command -v unzip >/dev/null 2>&1 || { echo "unzip is required." >&2; exit 1; }
  unzip -q -o "$ARCHIVE" -d "$GRADLE_USER_HOME/trustcraft-wrapper"
fi
exec "$GRADLE_BIN" -p "$APP_HOME" "$@"
